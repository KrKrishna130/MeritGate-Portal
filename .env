# Run python3 scripts/init_env.py to create .env with independent random secrets.
APP_NAME=MeritGate Examination Portal
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=086c5d3fd3465057b5e8461acf3c29c61b87e4d40d0d47e2c827db8adf6745fc
COOKIE_SECURE=false
WEB_PORT=5173
# Database and Redis have no host ports. The app connects on the Compose network.
POSTGRES_DB=exam
POSTGRES_USER=exam
POSTGRES_PASSWORD=78b16f9792f7dd1eaad132be77d330503f1c364355297308
DATABASE_URL=postgresql+psycopg://exam:78b16f9792f7dd1eaad132be77d330503f1c364355297308@postgres:5432/exam
REDIS_PASSWORD=6fb42464f9a9a53cbb71a0f13b1f5cf08817a26b4623eeb5
REDIS_URL=redis://:6fb42464f9a9a53cbb71a0f13b1f5cf08817a26b4623eeb5@redis:6379/0
# Only bootstrap creates the first administrator. Restarting preserves existing accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=69FxGl_f0qpU1JLzy1CBxkTe
SEED_DEMO=true
DEMO_CANDIDATE_PASSWORD=AyJbRpW87LYAKLgyR7GOE5Mn
# A heartbeat gap or repeated client events routes a closed exam to human review.
HEARTBEAT_GAP_SECONDS=60
REVIEW_EVENT_THRESHOLD=3
# Default: an administrator releases every outcome, even when no signals were received.
REQUIRE_ADMIN_RESULT_REVIEW=true
ENABLE_DEADLINE_SWEEPER=true
# This endpoint is internal. Console is http://localhost:9001.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=examadmin
MINIO_SECRET_KEY=71xxnaPKnnN6jtWZuwPieP5yVb9YtjHo
MINIO_SECURE=false
MINIO_OUTPUT_BUCKET=exam-reports
MINIO_CONSOLE_PORT=9001
# Optional local Ollama; not needed for taking or grading exams.
GEMMA_ENABLED=false
GEMMA_BASE_URL=http://host.docker.internal:11434/v1
GEMMA_API_KEY=not-needed
GEMMA_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120
